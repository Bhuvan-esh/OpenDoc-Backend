# ============================================================
# OpenDocs Voice & Learning Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ----- Application -----
APP_ENV=development          # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info               # debug | info | warning | error

# ----- Database (PostgreSQL 16 + pgvector) -----
# Used in production. InMemoryStore is used as the fallback in dev.
DATABASE_URL=postgresql://opendocs:opendocs_secret@localhost:5432/opendocs_db

# ----- Security -----
# Ed25519 signing key (base64-encoded). Leave empty to auto-generate on startup.
# In production, generate once and persist: python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; import base64; k=ed25519.Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes_raw()).decode())"
ED25519_PRIVATE_KEY_B64=

# ----- Fetch Guard -----
MAX_FETCH_BYTES=5242880      # 5 MB
REQUEST_TIMEOUT_SECONDS=8.0
MAX_REDIRECTS=3

# ----- Sandbox -----
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=0.5
SANDBOX_PIDS_LIMIT=64

# ----- Rate Limiting (future) -----
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ----- CORS -----
# Comma-separated list of allowed origins.
# Use * only in development.
CORS_ALLOWED_ORIGINS=*
